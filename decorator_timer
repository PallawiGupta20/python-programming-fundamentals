# Solution
import time

def timer(func):
    def wrapper(*args, **kwargs):
        start = time.time()
        result = func(*args, **kwargs)
        end = time.time()
        print(f"{func.__name__} took {end - start:.4f} seconds")
        return result
    return wrapper

@timer
def test_search_flow():
    time.sleep(1)   # simulating UI actions
    print("Search flow completed")

test_search_flow()