def find_duplicates(items):
    seen = {}
    duplicates = []
    for item in items:
        seen[item] = seen.get(item, 0) + 1
    for item, count in seen.items():
        if count > 1:
            duplicates.append(item)
    return duplicates

fruits = ["apple", "banana", "apple", "orange", "banana"]
print(find_duplicates(fruits))  # ['apple', 'banana']